{
  "name": "@shinvik/react-scrollable",
  "description": "Scrollable is a custom component made to handle scrolling with a custom scrollbar",
  "author": "Viktor Voloshin <viktor_the_great@mail.ru>",
  "version": "0.3.4",
  "type": "module",
  "main": "./dist/react-scrollable.umd.cjs",
  "module": "./dist/react-scrollable.js",
  "types": "./dist/react-scrollable.d.ts",
  "exports": {
    ".": {
      "import": "./dist/react-scrollable.js",
      "require": "./dist/react-scrollable.umd.cjs"
    }
  },
  "repository": "https://github.com/shinvik/react-scrollable.git",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react-scrollable",
    "scrollable",
    "overflow",
    "custom scrollabar",
    "styled scrollabar",
    "scrollbar"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "eslint ./src",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "storybook-docs": "storybook dev --docs",
    "build-storybook": "storybook build",
    "build-storybook-docs": "storybook build --docs",
    "test-storybook": "test-storybook",
    "test-storybook:watch": "test-storybook --watch",
    "test-unit": "vitest run",
    "test-unit:watch": "vitest",
    "test": "npm run test-storybook && npm run test-unit",
    "version": ".bin/update-doc-link-in-readme.sh"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/css": "^11.13.5",
    "@eslint/js": "^9.33.0",
    "@microsoft/api-extractor": "^7.58.9",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/rollup-plugin-peer-deps-external": "^2.2.6",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.2",
    "chromatic": "^13.3.5",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^10.5.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss-nested": "^7.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rollup-plugin-jsx-remove-attributes": "^3.1.2",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "storybook": "^10.5.0",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "unplugin-dts": "^1.0.3",
    "vite": "^7.3.6",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.7"
  }
}
